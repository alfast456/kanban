DB_USER=kanban_db
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kanban_db
# Migration runner credentials: database/schema owner role, not app role.
DB_MIGRATION_USER=kanban_migrator
DB_MIGRATION_PASSWORD=change-me
DB_POOL_MAX=10
JWT_SECRET=replace-with-32-byte-random-secret
# Google OAuth; callback must match Google Cloud Console exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3333/api/auth/google/callback
APP_URL=http://localhost:3333
PORT=3333
CORS_ORIGIN=http://localhost:5173
# Rotate DB_PASSWORD before production deployment
